{
  "name": "visorium",
  "version": "1.0.0",
  "type": "module",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoshydra/visorium.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "visorium": "./bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "NODE_ENV=production tsc -b && vite build",
    "build:spatial": "pnpm --filter @visorium/spatial build",
    "build:all": "pnpm build && pnpm build:spatial",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:versions": "node scripts/check-workspace-versions.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "preview": "vite preview",
    "start": "NODE_ENV=production node lib/cli/index.js",
    "lint:package": "publint"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "minimatch": "^9.0.5",
    "socket.io": "^4.8.1",
    "time-chainer": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "masonic": "^4.0.1",
    "publint": "^0.3.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^5.0.0",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "npm:rolldown-vite@^6.3.1",
    "vite-express": "^0.20.0",
    "vite-plugin-top-level-await": "^1.5.0"
  },
  "optionalDependencies": {
    "ffprobe-client": "^1.1.6",
    "sharp": "^0.34.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@^6.3.1"
    }
  }
}
